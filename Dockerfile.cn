FROM ubuntu:20.04

ENV DEBIAN_FRONTEND=noninteractive

RUN sed -i 's@//archive.ubuntu.com@//mirrors.aliyun.com@g; s@//security.ubuntu.com@//mirrors.aliyun.com@g' /etc/apt/sources.list && \
    apt-get update && \
    apt-get install -y --no-install-recommends \
        build-essential libc6-dev gdb file vim-common \
        python3 python3-pip && \
    python3 -m pip install --no-cache-dir -i https://pypi.tuna.tsinghua.edu.cn/simple pwntools && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /labs
COPY . /labs

RUN make -C lab-01-ret2text && make -C lab-02-ret2libc && \
    make -C lab-03-uaf && make -C lab-04-tcache

CMD ["/bin/bash"]
